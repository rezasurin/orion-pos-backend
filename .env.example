ORION_ENV=local
ORION_DATABASE_URL=postgres://orion_api:orion@localhost:5432/orion?sslmode=disable
ORION_MIGRATE_DATABASE_URL=postgres://orion_owner:orion@localhost:5432/orion?sslmode=disable
ORION_PLATFORM_DATABASE_URL=postgres://orion_admin:orion@localhost:5432/orion?sslmode=disable
ORION_HTTP_ADDR=:8080
# Base URL of the front end, for links in emails.
ORION_PUBLIC_URL=http://localhost:5173
# Signing keys, "kid:base64url-secret[,kid:secret...]" with secrets of 32 or more random bytes:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# The first key signs; the rest only verify, which is how a key is rotated. Optional locally
# (random keys are used, so tokens die at restart); required elsewhere.
ORION_JWT_TENANT_KEYS=
ORION_JWT_DEVICE_KEYS=
# Operator console (/admin and `orion admin`). The key encrypts operator TOTP seeds at rest, so
# keep it in the secret store, apart from database backups:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# The value below is for local development only.
ORION_SECRETS_KEY=b3Jpb24tbG9jYWwtZGV2ZWxvcG1lbnQta2V5LTAwMDE
ORION_JWT_OPERATOR_KEYS=
# "log" writes emails to the log. It is refused in production.
ORION_EMAIL_PROVIDER=log
# Set only behind exactly one proxy that appends the caller's address to X-Forwarded-For.
ORION_TRUST_PROXY=false
ORION_LOG_LEVEL=info
ORION_LOG_FORMAT=text
ORION_SHUTDOWN_TIMEOUT=15s
ORION_SENTRY_DSN=
